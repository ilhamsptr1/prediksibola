<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#00F5B8</item>
        <item name="colorPrimaryDark">#03050f</item>
        <item name="colorAccent">#00F5B8</item>
        <item name="android:windowBackground">#03050f</item>
        <item name="android:statusBarColor">#03050f</item>
        <item name="android:navigationBarColor">#03050f</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#03050f</item>
        <item name="android:statusBarColor">#03050f</item>
        <item name="android:navigationBarColor">#03050f</item>
    </style>

    <!-- Splash screen theme — shown while app loads -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#03050f</item>
        <item name="android:statusBarColor">#03050f</item>
        <item name="android:navigationBarColor">#03050f</item>
    </style>
</resources>